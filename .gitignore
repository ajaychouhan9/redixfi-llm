# secrets — never commit
.env
*.key
*.pem
kaggle.json

# fixtures may contain full annual-report text pulled from production.
# They are evaluation INPUT, not source. Export them per-environment.
fixtures/*.json
fixtures/*.jsonl
!fixtures/.gitkeep

# evaluation OUTPUT is normally transient and git-ignored...
# NOTE the trailing /* — ignoring the DIRECTORY itself would make the
# negations below unreachable (git cannot un-ignore a file inside an
# ignored directory).
evaluation/**/runs/*
evaluation/**/*.json
evaluation/**/*.md
!evaluation/**/.gitkeep

# ...EXCEPT the GPU RUN RESULTS, which are the deliverable a human reviews.
# They contain no secrets (model outputs + already-exported reference text)
# and losing them means re-spending metered GPU hours to recreate them.
#
# BUG FOUND 2026-08-29: this only allow-listed *qwen3*, so every Ministral
# run file (preflight, full eval, markdown-fairness) was silently dropped by
# `git add -A` across several commits whose messages claimed they were
# committed. `git add` does not error on an ignored path, so nothing caught
# it until a later check found the files missing from `git log`. Pattern is
# now by DIRECTORY, not by a per-model filename fragment, so a THIRD model
# cannot repeat this silently either.
!evaluation/annual_report/runs/*
!evaluation/concall/runs/*
!evaluation/red_flags/runs/*
!evaluation/ask_ai/runs/*
!evaluation/ministral_preflight/*
!evaluation/_gpu_run_*/

# Kaggle upload bundle — contains the fixtures, rebuild with
# scripts/make_sample_subset.py + the tar command in the runbook
kaggle_upload/

# models / weights — never in git
models/
*.safetensors
*.gguf
*.bin

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# local
.vscode/
.idea/
*.log

# kaggle_run.py's _save() fallback writes here when /kaggle/working is
# unavailable (e.g. a local test exercising die() on a dev machine) —
# debris, never a deliverable.
/kaggle_run_state.json
