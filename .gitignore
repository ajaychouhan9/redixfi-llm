# secrets — never commit
.env
*.key
*.pem
kaggle.json

# fixtures may contain full annual-report text pulled from production.
# They are evaluation INPUT, not source. Export them per-environment.
fixtures/*.json
fixtures/*.jsonl
!fixtures/.gitkeep

# evaluation OUTPUT is normally transient and git-ignored...
# NOTE the trailing /* — ignoring the DIRECTORY itself would make the
# negations below unreachable (git cannot un-ignore a file inside an
# ignored directory).
evaluation/**/runs/*
evaluation/**/*.json
evaluation/**/*.md
!evaluation/**/.gitkeep

# ...EXCEPT the GPU RUN RESULTS, which are the deliverable a human reviews.
# They contain no secrets (model outputs + already-exported reference text)
# and losing them means re-spending metered GPU hours to recreate them.
!evaluation/*/runs/*qwen3*
!evaluation/_gpu_run_*/

# Kaggle upload bundle — contains the fixtures, rebuild with
# scripts/make_sample_subset.py + the tar command in the runbook
kaggle_upload/

# models / weights — never in git
models/
*.safetensors
*.gguf
*.bin

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# local
.vscode/
.idea/
*.log
