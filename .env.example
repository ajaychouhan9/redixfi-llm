# ---------------------------------------------------------------------------
# LLM project — environment template. Copy to .env and fill in.
# NEVER commit .env. NEVER put real credentials in this file.
# ---------------------------------------------------------------------------

# --- Inference backend -----------------------------------------------------
# Which backend serves generations: vllm | openai | echo
# `echo` is the offline/no-GPU backend used by the local test suite.
LLM_BACKEND=echo

# Model id from app/models/registry.py (NOT a raw HF repo id — the registry
# maps a short name to repo, quantization, and T4-safe serving args).
LLM_MODEL=qwen3-14b-awq

# Where the vLLM OpenAI-compatible server is reachable from this process.
# On Kaggle this is the in-notebook server; locally it is usually unset.
VLLM_BASE_URL=http://127.0.0.1:8000/v1

# Deterministic generation defaults (evaluation requires these).
LLM_TEMPERATURE=0
LLM_SEED=0
LLM_MAX_TOKENS=1024

# --- This project's own OpenAI-compatible API ------------------------------
API_HOST=0.0.0.0
API_PORT=8080
# Optional shared secret. If set, /v1/* requires `Authorization: Bearer <this>`.
API_AUTH_TOKEN=

# --- Hugging Face ----------------------------------------------------------
# Needed only to download gated/large weights on Kaggle. Use a Kaggle Secret.
HF_TOKEN=

# --- Reference (OpenAI) backend -------------------------------------------
# ONLY used by the `openai` backend for optional reference re-generation.
# The evaluation harness does NOT need this: reference outputs come from the
# exported fixtures, which preserve what production already produced.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# RedixFi data access — READ-ONLY, and ONLY on the RedixFi VM.
#
# ARCHITECTURE NOTE, stated so nobody builds against a false one:
#   * MongoDB is bound to LOOPBACK on the RedixFi VM. There is no public
#     Mongo endpoint, and there is no MONGO_HOST/MONGO_PORT to point at
#     from elsewhere.
#   * ChromaDB is NOT a server. RedixFi uses chromadb.PersistentClient over
#     a local filesystem directory. There is therefore CHROMA_PATH and
#     deliberately NO CHROMA_HOST / CHROMA_PORT.
#
# Kaggle never uses any of these. The initial evaluation runs entirely from
# exported fixture files (see scripts/export_fixtures.py).
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=redixfi
MONGO_APP_DB_NAME=redixfi_app
CHROMA_PATH=/home/ubuntu/redixfi-backend/data/chroma_production

# Path to the RedixFi checkout, used ONLY by scripts/export_fixtures.py on the
# VM so it can call the REAL evidence_finder.py rather than reimplementing it.
REDIXFI_ROOT=/home/ubuntu/redixfi-backend
